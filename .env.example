APP_ENV=dev

SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_login_name
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# Facultatif : SNOWFLAKE_PASSWORD est nécessaire uniquement avec l'authenticator `snowflake`.
SNOWFLAKE_PASSWORD=
# Les valeurs ci-dessous remplacent celles de config/dev.yaml si elles sont renseignées.
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
